# HTTPS Neon database URL (no credentials, no query string).
# Example: https://ep-example.c-2.us-east-1.aws.neon.tech/neondb
# Derive from Data API URL by removing .apirest and /rest/v1.
# Never put a Postgres connection string here.
VITE_NEON_DATABASE_URL=

# Optional overrides if Auth and Data API URLs cannot be derived:
# VITE_NEON_AUTH_URL=https://ep-example.neonauth.us-east-1.aws.neon.tech/neondb/auth
# VITE_NEON_DATA_API_URL=https://ep-example.apirest.us-east-1.aws.neon.tech/neondb/rest/v1
